# SerpApi Search Engine Key (Required for Google Lens / Google Reverse Image searches)
# Sign up at https://serpapi.com/ to get a free key
SERPAPI_API_KEY=your_serpapi_api_key_here

# ImgBB API Key (Optional fallback)
# If not specified, the system will fall back to tmpfiles.org for free API-key-less temporary image hosting.
# Sign up at https://api.imgbb.com/ to get a free key if you want a dedicated account.
IMGBB_API_KEY=
